export WRAPPER=/users/smayani/wrapper-mpi.sh

mkdir -p data
export OMP_PROC_BIND=spread
export OMP_PLACES=threads
export OMP_NUM_THREADS=72

srun $WRAPPER ./LandauDamping 32 32 32 83886080 200 FFT 0.01 LeapFrog --overallocate 2.0 --info 5
